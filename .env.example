# EPC Open Data Communities API
# Register at: https://epc.opendatacommunities.org/
EPC_EMAIL=hello@epc2c.co.uk
EPC_API_KEY=your-api-key-here
# EPC_BASE=https://epc.opendatacommunities.org/api/v1/domestic  # default, no need to set

# Upstash Redis — for property session storage (Stripe redirect restore)
# Create a free database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Supabase — accounts, saved properties, report history
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key   # safe to expose; RLS protects data
# SUPABASE_SERVICE_KEY is only needed for server-side admin tasks (e.g. a future
# Stripe payment webhook). The report/property API routes do NOT use it.
SUPABASE_SERVICE_KEY=your-service-role-key

# Cloudflare Turnstile — bot protection on the property search
# Dashboard → Turnstile → your widget. Site key is public (lives in the HTML);
# the secret key must stay server-side. Add the same secret to Vercel env vars.
TURNSTILE_SECRET=your-turnstile-secret-key

# SMTP — for the post-purchase "plan is ready" email (api/send-plan-email.js)
# SiteGround mailbox: hello@epc2c.co.uk
SMTP_HOST=gukm1078.siteground.biz
SMTP_PORT=465
SMTP_USER=hello@epc2c.co.uk
SMTP_PASS=your-mailbox-password
# SMTP_FROM=EPC2C <hello@epc2c.co.uk>   # optional; defaults to SMTP_USER
# SITE_URL=https://www.epc2c.co.uk      # optional; used for the dashboard link
