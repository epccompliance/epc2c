# EPC Open Data Communities API
# Register at: https://epc.opendatacommunities.org/
EPC_EMAIL=hello@epc2c.co.uk
EPC_API_KEY=your-api-key-here
# EPC_BASE=https://epc.opendatacommunities.org/api/v1/domestic  # default, no need to set

# Upstash Redis — for property session storage (Stripe redirect restore)
# Create a free database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
